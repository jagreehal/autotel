# Langfuse credentials. Without these the example still runs and prints spans
# locally; it just does not forward them.
#
# Local, no signup — start the stack and use the keys it provisions:
#
#   docker compose -f ../../docker/langfuse.yml up -d
#
# LANGFUSE_BASEURL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-0d5c0dc9-3b4f-4f3c-9d3a-000000000001
# LANGFUSE_SECRET_KEY=sk-lf-0d5c0dc9-3b4f-4f3c-9d3a-000000000002
#
# Cloud — copy from Project Settings at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Fan out to autotel-devtools too (run `npx autotel-devtools` first)
# DEVTOOLS=1
# DEVTOOLS_ENDPOINT=http://127.0.0.1:4318

# Ollama model overrides (optional). Default granite4 is reliable with tools.
# OLLAMA_MODEL=granite4
# OLLAMA_EMBED_MODEL=nomic-embed-text
