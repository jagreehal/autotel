{
  "name": "@jagreehal/example-nestjs",
  "version": "1.0.69",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prestart": "pnpm run build",
    "start": "node --import ./dist/instrumentation.js dist/src/main.js",
    "start:dev": "tsx --import ./instrumentation.ts src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "autotel": "workspace:*",
    "autotel-adapters": "workspace:*",
    "dotenv": "^18.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
