{
  "name": "@jagreehal/example-hono",
  "version": "1.0.60",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --import ./instrumentation.ts src/index.ts",
    "map": "autotel map",
    "map:check": "autotel map --baseline --min-score 60",
    "coverage": "tsx src/coverage-check.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "autotel": "workspace:*",
    "autotel-adapters": "workspace:*",
    "autotel-devtools": "workspace:*",
    "autotel-hono": "workspace:*",
    "dotenv": "^17.4.2",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "autotel-cli": "workspace:*",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
