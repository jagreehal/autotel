# Local LGTM stack (docker compose -f grafana/lgtm.overlay.yml up -d).
# Leave the Cloud settings commented out and the example uses the local stack.
# 5s so rate() has points to work with over a short run; 60s is the default.
OTEL_METRIC_EXPORT_INTERVAL=5000

# Grafana Cloud OTLP ingestion — endpoint and headers from the Cloud Portal:
# your stack → Connections → OpenTelemetry → Configure. A glsa_/glc_ token is
# for the stack HTTP API, not for OTLP.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-gb-south-1.grafana.net/otlp"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20YOUR_BASE64_INSTANCE_ID_AND_TOKEN"

# Optional: service name (default: carrier-gateway; the queries in ./grafana
# match this name)
# OTEL_SERVICE_NAME=carrier-gateway

# Optional: how long the run stays healthy before the carrier token breaks,
# and how long it keeps quoting
# INCIDENT_AFTER_SECONDS=90
# RUN_FOR_SECONDS=600
