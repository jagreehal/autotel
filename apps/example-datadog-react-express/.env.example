# Server: Datadog API key and site. The key never reaches the browser.
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# Both halves: unified service tagging.
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=local

# Browser, optional: a Datadog RUM application (Errors > Settings > Browser).
# Without these, RUM is off and errors reach Datadog Error Tracking through
# autotel's spans alone.
VITE_DD_RUM_APPLICATION_ID=
VITE_DD_RUM_CLIENT_TOKEN=
VITE_DD_SITE=datadoghq.com
# Optional: manage replay rate, privacy etc. from Datadog without a deploy.
VITE_DD_RUM_REMOTE_CONFIG_ID=

# Browser, optional: PostHog (analytics, replay, error tracking).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional: RUM through your own origin (ad blockers), e.g. /rum-intake.
VITE_DD_RUM_PROXY=

# Which tool owns errors: autotel | rum | posthog. Defaults to PostHog if it
# is on, else RUM if it is on, else autotel (Datadog Error Tracking).
VITE_ERRORS=
