{
  "name": "@jagreehal/example-skybridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Skybridge MCP App traced with autotel-skybridge",
  "scripts": {
    "dev": "SKYBRIDGE_TELEMETRY_DISABLED=1 skybridge dev",
    "build": "SKYBRIDGE_TELEMETRY_DISABLED=1 skybridge build",
    "start": "SKYBRIDGE_TELEMETRY_DISABLED=1 skybridge start",
    "call": "tsx scripts/call.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "autotel": "workspace:*",
    "autotel-skybridge": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skybridge": "^2.0.4",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@skybridge/devtools": "^2.0.4",
    "@skybridge/vite-plugin": "^2.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autotel-mcp-instrumentation": "workspace:*",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
