---
import HeroTraceIsland from './HeroTraceIsland';

/* Two audiences arrive at this page and neither wants the other's command. A
   person wants the package; an agent wants the one call that detects the
   project, wires it, and reports back as JSON it can parse. */
const installCmds = {
  humans: 'npm install autotel',
  agents: 'npx autotel init --yes --json',
};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">
        <span>v1.x</span>
        <span class="eyebrow__sep" aria-hidden="true">/</span>
        <span>Apache-2.0</span>
        <span class="eyebrow__sep" aria-hidden="true">/</span>
        <span>OpenTelemetry-native</span>
      </p>

      <h1 id="hero-title" class="wordmark">
        autotel<span class="cursor" aria-hidden="true">_</span>
      </h1>

      <p class="tagline">
        Zero-boilerplate OpenTelemetry for TypeScript. Wrap a function and get
        spans, product events, and structured errors without the SDK wiring.
      </p>

      {/* Radios rather than buttons: the choice is one-of-two, so the browser
          already has the semantics, the keyboard behaviour and the focus ring.
          No island, no hydration, no JS at all — the panels are swapped by
          :checked sibling selectors. */}
      <fieldset class="install-switch">
        <legend class="sr-only">Install command</legend>

        <input
          type="radio"
          name="audience"
          id="audience-humans"
          value="humans"
          checked
        />
        <label for="audience-humans">Humans</label>

        <input type="radio" name="audience" id="audience-agents" value="agents" />
        <label for="audience-agents">Agents</label>

        <div class="install-panels">
          <div class="install install--humans">
            <span class="prompt" aria-hidden="true">$</span>
            <code>{installCmds.humans}</code>
          </div>
          <div class="install install--agents">
            <span class="prompt" aria-hidden="true">$</span>
            <code>{installCmds.agents}</code>
          </div>
        </div>
      </fieldset>

      <div class="actions">
        <a class="btn btn--primary" href="/autotel/quick-start/">
          <span>Get started</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="https://github.com/jagreehal/autotel">
          <span>GitHub</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="hero__trace">
      <HeroTraceIsland client:visible />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(2rem, 5vw, 4.5rem);
    isolation: isolate;
  }

  .hero__grid {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    }
  }

  .hero__copy {
    min-width: 0;
  }

  /* Eyebrow — mono, tracked, quiet grey. No accent dot: blue lives only in the trace. */
  .eyebrow {
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-storm-cloud);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.75rem;
    font-weight: 510;
  }

  :root[data-theme='light'] .eyebrow {
    color: var(--sl-color-gray-3);
  }

  .eyebrow__sep {
    color: var(--color-fog-grey);
  }

  :root[data-theme='light'] .eyebrow__sep {
    color: var(--sl-color-gray-3);
  }

  .wordmark {
    font-family: var(--sl-font-mono);
    font-size: clamp(3.25rem, 8.5vw, 6rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
    font-weight: 400;
    margin: 0 0 1.5rem;
    color: var(--color-porcelain);
    border: 0;
  }

  :root[data-theme='light'] .wordmark {
    color: var(--color-pitch-black);
  }

  /* Blinking cursor — the terminal motif, tracks the wordmark colour. */
  .cursor {
    display: inline-block;
    color: var(--color-porcelain);
    margin-left: 0.03em;
    animation: blink 1.05s steps(1) infinite;
  }

  :root[data-theme='light'] .cursor {
    color: var(--color-pitch-black);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .tagline {
    font-family: var(--sl-font-mono);
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
    line-height: 1.6;
    color: var(--color-light-steel);
    max-width: 46ch;
    margin: 0 0 2rem;
    letter-spacing: -0.005em;
  }

  :root[data-theme='light'] .tagline {
    color: var(--sl-color-gray-2);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .install-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    border: 0;
    padding: 0;
    margin: 0 0 1.75rem;
    min-inline-size: 0;
  }

  /* The radio is the accessible control; the label is what's painted. Clipped
     rather than sized to zero, so it keeps a box the browser will scroll to
     when it takes focus. Pointer input arrives through the label, keyboard and
     assistive tech through the radio itself. */
  .install-switch input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .install-switch label {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-charcoal-grey);
    border-radius: 999px;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    letter-spacing: -0.005em;
    color: var(--color-storm-cloud);
    cursor: pointer;
    transition:
      background var(--sl-transition),
      border-color var(--sl-transition),
      color var(--sl-transition);
  }

  :root[data-theme='light'] .install-switch label {
    border-color: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }

  .install-switch label:hover {
    color: var(--color-porcelain);
    border-color: var(--color-gunmetal);
  }

  :root[data-theme='light'] .install-switch label:hover {
    color: var(--color-pitch-black);
    border-color: var(--sl-color-gray-4);
  }

  .install-switch input:checked + label {
    background: var(--color-porcelain);
    border-color: var(--color-porcelain);
    color: var(--color-pitch-black);
  }

  :root[data-theme='light'] .install-switch input:checked + label {
    background: var(--color-pitch-black);
    border-color: var(--color-pitch-black);
    color: var(--color-porcelain);
  }

  /* Focus lives on the label, since the input it belongs to is visually gone. */
  .install-switch input:focus-visible + label {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* Forces the command onto its own line under the two pills. */
  .install-panels {
    flex-basis: 100%;
    margin-top: 0.6rem;
  }

  .install {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--color-charcoal-grey);
    border-radius: 6px;
    background: var(--color-graphite);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
  }

  :root[data-theme='light'] .install {
    border-color: var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
  }

  /* Only the selected audience's command is rendered at all, so the hidden one
     is never read out by a screen reader or copied by mistake. */
  .install--agents,
  #audience-agents:checked ~ .install-panels .install--humans {
    display: none;
  }

  #audience-agents:checked ~ .install-panels .install--agents {
    display: inline-flex;
  }

  .install .prompt {
    color: var(--color-storm-cloud);
    /* stays put in dark; light needs a darker grey to clear 4.5:1 on gray-6 */
    user-select: none;
    font-weight: 590;
  }

  :root[data-theme='light'] .install .prompt {
    color: var(--sl-color-gray-3);
  }

  .install code {
    color: var(--color-porcelain);
    background: transparent;
    padding: 0;
    border: 0;
    border-radius: 0;
  }

  :root[data-theme='light'] .install code {
    color: var(--color-pitch-black);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.05rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    font-weight: 510;
    letter-spacing: -0.005em;
    text-decoration: none;
    border-radius: 6px;
    transition:
      background var(--sl-transition),
      border-color var(--sl-transition),
      color var(--sl-transition);
  }

  .btn .arrow {
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .btn:hover .arrow {
    transform: translateX(2px);
  }

  /* Primary is the strongest monochrome move — the highest-contrast solid.
     White-on-black in dark, black-on-white in light. */
  .btn--primary {
    background: var(--color-porcelain);
    color: var(--color-pitch-black);
    border: 1px solid var(--color-porcelain);
  }

  .btn--primary:hover {
    background: var(--color-alabaster);
    border-color: var(--color-alabaster);
  }

  :root[data-theme='light'] .btn--primary {
    background: var(--color-pitch-black);
    color: var(--color-porcelain);
    border-color: var(--color-pitch-black);
  }

  :root[data-theme='light'] .btn--primary:hover {
    background: var(--color-charcoal-grey);
    border-color: var(--color-charcoal-grey);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-porcelain);
    border: 1px solid var(--color-muted-ash);
  }

  .btn--ghost:hover {
    border-color: var(--color-gunmetal);
    background: var(--color-graphite);
  }

  :root[data-theme='light'] .btn--ghost {
    color: var(--color-pitch-black);
    border-color: var(--sl-color-gray-5);
  }

  :root[data-theme='light'] .btn--ghost:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }

  .hero__trace {
    min-width: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none !important;
    }
  }
</style>
