{
  "name": "autotel-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Write Once, Observe Anywhere - Zero-boilerplate OpenTelemetry for JavaScript/TypeScript",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:anti-slop": "oxlint",
    "format": "prettier --write .",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "pnpm --filter autotel run test:e2e",
    "test:playwright-e2e": "pnpm --filter @jagreehal/example-playwright-e2e test",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "bundle-size:update": "node scripts/check-bundle-size.mjs --update",
    "check-exports-map": "node scripts/check-exports-map.mjs",
    "check-semconv-drift": "node scripts/check-semconv-drift.mjs",
    "clean": "turbo clean",
    "type-check": "turbo type-check",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "quality": "turbo run build && turbo run build-storybook && turbo run lint && pnpm run format:check && turbo run type-check && turbo run test && turbo run test:integration && pnpm run check-exports-map && pnpm run check-semconv-drift",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.86.0",
    "esbuild": "^0.28.2",
    "oxlint": "1.86.0",
    "oxlint-plugin-eslint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "turbo": "^2.11.5",
    "unrun": "0.3.1"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/autotel.git"
  },
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "keywords": [],
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel#readme",
  "overrides": {
    "vite": ">=7.1.11 <8"
  }
}
