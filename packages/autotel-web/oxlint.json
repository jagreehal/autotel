{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../tools/oxlint/base.json"],
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "rules": {
    "no-unexpected-multiline": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_",
            "args": "none"
          }
        ]
      }
    }
  ]
}
