{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../tools/oxlint/base.json",
    "../../tools/oxlint/unicorn.json"
  ],
  "plugins": ["typescript", "unicorn"],
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": [
    {
      "name": "eslint-js",
      "specifier": "oxlint-plugin-eslint"
    }
  ],
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "es2026": true
  },
  "ignorePatterns": ["dist/**"],
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "unicorn/filename-case": "off",
        "unicorn/no-null": "off",
        "unicorn/prefer-top-level-await": "off",
        "unicorn/no-nested-ternary": "off",
        "unicorn/no-this-assignment": "off",
        "unicorn/no-array-for-each": "off",
        "unicorn/no-array-reduce": "off",
        "unicorn/prefer-export-from": "off",
        "unicorn/prefer-type-error": "off",
        "unicorn/explicit-length-check": "off",
        "unicorn/prefer-at": "off",
        "unicorn/prefer-string-slice": "off",
        "unicorn/prefer-number-properties": "off",
        "unicorn/prefer-default-parameters": "off",
        "unicorn/prefer-ternary": "off",
        "unicorn/no-useless-undefined": "off",
        "unicorn/prefer-optional-catch-binding": "off",
        "unicorn/catch-error-name": "off",
        "no-unused-vars": "off",
        "typescript/no-explicit-any": "off",
        "typescript/consistent-type-exports": "error",
        "typescript/no-this-alias": "off",
        "typescript/no-unsafe-function-type": "off",
        "typescript/ban-ts-comment": "off",
        "typescript/no-unnecessary-type-constraint": "off"
      }
    },
    {
      "files": ["src/**/*.test.ts", "src/**/*.integration.test.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "unicorn/filename-case": "off",
        "unicorn/no-null": "off",
        "unicorn/prefer-top-level-await": "off",
        "unicorn/no-nested-ternary": "off",
        "unicorn/no-useless-undefined": "off",
        "unicorn/prefer-optional-catch-binding": "off",
        "unicorn/catch-error-name": "off",
        "no-unused-vars": "off",
        "typescript/no-explicit-any": "off",
        "typescript/consistent-type-exports": "off"
      }
    },
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "ExportAllDeclaration",
            "message": "Barrel exports (export * from) are not allowed. Use explicit named exports instead."
          },
          {
            "selector": "TSEnumDeclaration",
            "message": "Enums are not allowed. Use union types or const assertions instead."
          }
        ]
      }
    },
    {
      "files": [
        "src/index.ts",
        "src/sampling.ts",
        "src/events.ts",
        "src/logger.ts",
        "src/testing.ts",
        "src/bindings.ts",
        "src/handlers.ts"
      ],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "TSEnumDeclaration",
            "message": "Enums are not allowed. Use union types or const assertions instead."
          }
        ]
      }
    },
    {
      "files": ["src/**/*.test.ts", "src/**/*.integration.test.ts"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "ExportAllDeclaration",
            "message": "Barrel exports (export * from) are not allowed. Use explicit named exports instead."
          },
          {
            "selector": "TSEnumDeclaration",
            "message": "Enums are not allowed. Use union types or const assertions instead."
          }
        ]
      }
    }
  ]
}
