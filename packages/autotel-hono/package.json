{
  "name": "autotel-hono",
  "version": "0.4.65",
  "description": "OpenTelemetry Hono middleware powered by autotel",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "autotel": "workspace:*",
    "autotel-adapters": "workspace:*"
  },
  "peerDependencies": {
    "hono": ">=4.13.10"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "hono": "^4.13.10",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-hono"
  }
}
