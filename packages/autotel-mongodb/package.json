{
  "name": "autotel-mongodb",
  "version": "0.1.0",
  "description": "MongoDB query insight for OpenTelemetry: value-free db.query.text that groups, and db.plan.* from explain() with an ESR index suggestion",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "test": "vitest run",
    "clean": "rimraf dist",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "autotel-db": "workspace:*"
  },
  "peerDependencies": {
    "autotel": "*"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-mongodb": "^0.75.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@types/node": "^26.6.3",
    "autotel": "workspace:*",
    "mongodb": "^7.6.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "database",
    "mongodb",
    "mongoose",
    "explain",
    "observability",
    "autotel"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-mongodb"
  }
}
