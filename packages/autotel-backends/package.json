{
  "name": "autotel-backends",
  "version": "2.14.8",
  "description": "Vendor backend configurations for Autotel (Honeycomb, Datadog, etc.)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./honeycomb": {
      "types": "./dist/honeycomb.d.ts",
      "import": "./dist/honeycomb.js",
      "require": "./dist/honeycomb.cjs"
    },
    "./datadog": {
      "types": "./dist/datadog.d.ts",
      "import": "./dist/datadog.js",
      "require": "./dist/datadog.cjs"
    },
    "./google-cloud": {
      "types": "./dist/google-cloud.d.ts",
      "import": "./dist/google-cloud.js",
      "require": "./dist/google-cloud.cjs"
    },
    "./grafana": {
      "types": "./dist/grafana.d.ts",
      "import": "./dist/grafana.js",
      "require": "./dist/grafana.cjs"
    },
    "./logfire": {
      "types": "./dist/logfire.d.ts",
      "import": "./dist/logfire.js",
      "require": "./dist/logfire.cjs"
    },
    "./langfuse": {
      "types": "./dist/langfuse.d.ts",
      "import": "./dist/langfuse.js",
      "require": "./dist/langfuse.cjs"
    },
    "./posthog": {
      "types": "./dist/posthog.d.ts",
      "import": "./dist/posthog.js",
      "require": "./dist/posthog.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "ci": "npm run build && npm run check-format && npm run check-exports && npm run lint && npm run test",
    "dev": "tsdown --watch",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "lint:fix": "pnpm lint --fix",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "check-format": "prettier --check ./src",
    "check-exports": "attw --pack . --ignore-rules false-esm no-resolution cjs-resolves-to-esm",
    "clean": "rimraf dist",
    "quality": "pnpm type-check && pnpm test && pnpm lint && pnpm format:check && pnpm build && pnpm check-exports"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "autotel",
    "backend",
    "honeycomb",
    "datadog",
    "google-cloud",
    "gcp",
    "configuration",
    "observability",
    "tracing",
    "telemetry",
    "vendor"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "dependencies": {
    "autotel": "workspace:*",
    "@opentelemetry/exporter-logs-otlp-http": ">=0.222.0",
    "@opentelemetry/sdk-logs": ">=0.222.0"
  },
  "peerDependencies": {
    "@opentelemetry/exporter-metrics-otlp-http": ">=0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.222.0",
    "@opentelemetry/sdk-metrics": ">=2.11.0",
    "google-auth-library": ">=10.9.1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/exporter-metrics-otlp-http": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    },
    "google-auth-library": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-backends"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel#readme"
}
