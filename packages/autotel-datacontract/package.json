{
  "name": "autotel-datacontract",
  "version": "0.1.0",
  "description": "Open Data Contract Standard (ODCS) contracts held to account: validate records and events at runtime with the track record as OpenTelemetry metrics, audit legacy databases for variances and unknowns, draft contracts from existing data, catch breaking changes in CI, and bridge to JSON Schema.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "require": "./dist/db.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    }
  },
  "bin": {
    "autotel-datacontract": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "lint:fix": "pnpm lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "keywords": [
    "autotel",
    "opentelemetry",
    "data-contract",
    "odcs",
    "open-data-contract-standard",
    "data-quality",
    "data-mesh",
    "schema-drift",
    "breaking-change-detection"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-datacontract"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel/tree/main/packages/autotel-datacontract#readme"
}
