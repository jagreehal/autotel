{
  "name": "autotel-builtin-ai",
  "version": "4.0.0",
  "description": "OpenTelemetry instrumentation for Chrome's built-in AI APIs - traces on-device model sessions from the browser",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "autotel-web": "^2.2.1"
  },
  "keywords": [
    "chrome",
    "built-in-ai",
    "prompt-api",
    "gemini-nano",
    "gemma",
    "opentelemetry",
    "autotel"
  ],
  "license": "Apache-2.0",
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-builtin-ai"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel/tree/main/packages/autotel-builtin-ai#readme",
  "devDependencies": {
    "autotel-web": "workspace:*",
    "happy-dom": "20.14.5",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
