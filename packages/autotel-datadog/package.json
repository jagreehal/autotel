{
  "name": "autotel-datadog",
  "version": "0.0.0",
  "description": "Join autotel-web traces to Datadog RUM: RUM errors carry the trace, spans carry the RUM session and replay",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@opentelemetry/sdk-trace-base": ">=2.12.0",
    "autotel-web": "workspace:*"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "datadog",
    "rum",
    "error-tracking",
    "browser",
    "autotel"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-datadog"
  },
  "devDependencies": {
    "@datadog/browser-rum": "7.16.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "autotel-web": "workspace:*",
    "jsdom": "30.1.3",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
