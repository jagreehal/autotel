          "expr": "sum by (gen_ai_request_model) (rate({__name__=~\"gen_ai_client_operation_duration(_seconds)?_count\",service_name=~\"$service\",gen_ai_request_model=~\"$model\"}[5m]))",
          "legendFormat": "{{gen_ai_request_model}}",
          "refId": "A"
        }
      ],
      "title": "Requests/sec by model",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
