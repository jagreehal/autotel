{
  "name": "autotel-mcp",
  "version": "0.4.1",
  "description": "MCP server for AI agents to investigate OpenTelemetry traces, metrics, and logs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "autotel-mcp": "./bin/autotel-mcp"
  },
  "files": [
    "dist",
    "bin",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/server.ts",
    "dev:http": "AUTOTEL_TRANSPORT=http tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:http": "AUTOTEL_TRANSPORT=http node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "format:check": "prettier --check src/**/*.ts"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "observability",
    "traces",
    "metrics",
    "logs",
    "otlp",
    "collector"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/otlp-transformer": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ajv": "^8.20.0",
    "hono": "^4.12.32",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.1.2",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-mcp"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel/tree/main/packages/autotel-mcp#readme"
}
