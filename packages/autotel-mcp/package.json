{
  "name": "autotel-mcp",
  "version": "0.14.3",
  "description": "MCP server for AI agents to investigate OpenTelemetry traces, metrics, and logs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "autotel-mcp": "./bin/autotel-mcp"
  },
  "files": [
    "dist",
    "bin",
    "fixtures",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/server.ts",
    "dev:http": "AUTOTEL_TRANSPORT=http tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:http": "AUTOTEL_TRANSPORT=http node dist/server.js",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "lint:fix": "pnpm lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "format:check": "prettier --check src/**/*.ts"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "observability",
    "traces",
    "metrics",
    "logs",
    "otlp",
    "collector"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/otlp-transformer": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ajv": "^8.20.0",
    "autotel-db": "workspace:*",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "autotel-devtools": "workspace:*",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-mcp"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel/tree/main/packages/autotel-mcp#readme"
}
