{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../tools/oxlint/base.json"],
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist/**"],
  "rules": {
    "no-unexpected-multiline": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "typescript/no-this-alias": "error"
  }
}
