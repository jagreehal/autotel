{
  "name": "autotel-cli",
  "version": "0.19.0",
  "description": "CLI for autotel - setup wizard, diagnostics, and incremental features",
  "type": "module",
  "bin": {
    "autotel": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "autotel-mcp": "workspace:*",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "ora": "^9.4.1",
    "semver": "^7.8.5",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "autotel-telemetry": "workspace:*",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "opentelemetry",
    "tracing",
    "observability",
    "cli",
    "autotel"
  ],
  "author": "Jag Reehal<jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel#readme"
}
