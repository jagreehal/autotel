{
  "spec": "autotel-schema-snapshot/v1",
  "service": "autotel-agent-security",
  "version": "1.0.0",
  "commonAttributes": {
    "agent.action.risk_class": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "read",
        "write",
        "destructive",
        "financial",
        "exfiltration_capable"
      ]
    },
    "agent.consent.evidence": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "observed",
        "inferred"
      ],
      "description": "Whether the consent outcome was witnessed or reconstructed. Defaults to inferred: no runtime reports the human click, so an approval deduced from the tool having run must never be cited as a human decision."
    },
    "agent.consent.outcome": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "approved",
        "denied",
        "timeout",
        "revoked"
      ]
    },
    "agent.consent.required": {
      "type": "boolean",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "agent.controller.id": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": true,
      "description": "Hashed controlling human user id"
    },
    "agent.input.provenance": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "user_direct",
        "user_voice",
        "rag",
        "memory",
        "tool_result",
        "external_untrusted"
      ]
    },
    "agent.memory.isolation_key": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": true
    },
    "agent.memory.operation": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "read",
        "write",
        "delete",
        "search"
      ]
    },
    "agent.plan.risk.categories": {
      "type": "string[]",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "agent.plan.risk.score": {
      "type": "number",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "agent.plan.risk.verdict": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "agent.plan.step_index": {
      "type": "number",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "agent.plan.tool_intents": {
      "type": "string[]",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "agent.scope.active": {
      "type": "string[]",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "autotel.agent": {
      "type": "boolean",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "description": "Agent audit marker"
    },
    "detection.correlation_id": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": true,
      "description": "Session the detection belongs to"
    },
    "detection.disposition.note": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "description": "Why the finding was closed. Required for false_positive and risk_accepted."
    },
    "detection.disposition.status": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "new",
        "acknowledged",
        "in_progress",
        "resolved",
        "false_positive",
        "risk_accepted"
      ],
      "description": "Triage decision recorded against a detection"
    },
    "detection.disposition.supersedes": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "new",
        "acknowledged",
        "in_progress",
        "resolved",
        "false_positive",
        "risk_accepted"
      ],
      "description": "Status this decision replaces — dispositions are appended, never edited, so a reversal survives."
    },
    "detection.first_at": {
      "type": "number",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "description": "Epoch ms of the first step matched by the rule"
    },
    "detection.last_at": {
      "type": "number",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "description": "Epoch ms of the last step matched by the rule"
    },
    "detection.rule_id": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "description": "Sequence rule that fired"
    },
    "detection.severity": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Severity of the rule that fired"
    },
    "detection.steps": {
      "type": "number",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "description": "How many ordered steps the rule matched"
    },
    "mcp.security.injection.verdict": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "clean",
        "suspicious",
        "malicious"
      ]
    },
    "mcp.tool.destructive": {
      "type": "boolean",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "mcp.tool.untrusted_content": {
      "type": "boolean",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "policy.decision": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "permit",
        "deny",
        "challenge",
        "observe",
        "error"
      ]
    },
    "security.category": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "security.event": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "security.outcome": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "security.severity": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false,
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "tool.input_hash": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    },
    "tool.output_hash": {
      "type": "string",
      "stability": "stable",
      "required": false,
      "highCardinality": false
    }
  },
  "spans": {
    "agent.action": {
      "stability": "stable",
      "additionalAttributes": false,
      "attributes": {
        "agent.id": {
          "type": "string",
          "stability": "stable",
          "required": true,
          "highCardinality": false
        },
        "tool.name": {
          "type": "string",
          "stability": "stable",
          "required": false,
          "highCardinality": false
        }
      },
      "description": "Scoped agent action or tool call with audit metadata"
    },
    "tools/call": {
      "stability": "stable",
      "additionalAttributes": false,
      "attributes": {
        "mcp.tool.name": {
          "type": "string",
          "stability": "stable",
          "required": true,
          "highCardinality": false
        }
      },
      "description": "MCP tool invocation with boundary security signals"
    }
  }
}
