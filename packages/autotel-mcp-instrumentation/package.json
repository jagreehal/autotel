{
  "name": "autotel-mcp-instrumentation",
  "version": "60.1.0",
  "description": "OpenTelemetry instrumentation for Model Context Protocol (MCP) with distributed tracing support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js",
      "require": "./dist/metrics.cjs"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js",
      "require": "./dist/security.cjs"
    },
    "./semantic-conventions": {
      "types": "./dist/semantic-conventions.d.ts",
      "import": "./dist/semantic-conventions.js",
      "require": "./dist/semantic-conventions.cjs"
    }
  },
  "imports": {
    "#runtime": {
      "workerd": {
        "types": "./dist/runtime.edge.d.ts",
        "import": "./dist/runtime.edge.js",
        "require": "./dist/runtime.edge.cjs"
      },
      "worker": {
        "types": "./dist/runtime.edge.d.ts",
        "import": "./dist/runtime.edge.js",
        "require": "./dist/runtime.edge.cjs"
      },
      "browser": {
        "types": "./dist/runtime.edge.d.ts",
        "import": "./dist/runtime.edge.js",
        "require": "./dist/runtime.edge.cjs"
      },
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "lint:fix": "pnpm lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "clean": "rimraf dist",
    "format:check": "prettier --check src/**/*.ts"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "mcp",
    "model-context-protocol",
    "distributed-tracing",
    "observability",
    "instrumentation",
    "w3c-trace-context"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "autotel": "*",
    "autotel-edge": "*"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "autotel": {
      "optional": true
    },
    "autotel-edge": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "@types/node": "^26.6.5",
    "autotel": "workspace:*",
    "autotel-edge": "workspace:*",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-mcp-instrumentation"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel/tree/main/packages/autotel-mcp-instrumentation#readme"
}
