{
  "name": "autotel-posthog",
  "version": "7.0.0",
  "description": "Everything PostHog for autotel: browser session/replay join, server-side event subscriber, and trace links in both directions",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./subscriber": {
      "types": "./dist/subscriber.d.ts",
      "import": "./dist/subscriber.js",
      "require": "./dist/subscriber.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "slow-redact": "^0.3.2"
  },
  "peerDependencies": {
    "@opentelemetry/sdk-trace-base": ">=2.0.0",
    "autotel": "workspace:*",
    "autotel-subscribers": "workspace:*",
    "autotel-web": "workspace:*",
    "posthog-js": ">=1.200.0",
    "posthog-node": ">=4.0.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@types/node": "^26.1.2",
    "autotel": "workspace:*",
    "autotel-subscribers": "workspace:*",
    "autotel-web": "workspace:*",
    "jsdom": "29.1.1",
    "posthog-js": "1.417.1",
    "posthog-node": "^4.18.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "posthog",
    "session-replay",
    "product-analytics",
    "tracing",
    "observability",
    "autotel"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-posthog"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "posthog-js": {
      "optional": true
    },
    "autotel": {
      "optional": true
    },
    "autotel-subscribers": {
      "optional": true
    },
    "posthog-node": {
      "optional": true
    }
  }
}
