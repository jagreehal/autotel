{
  "name": "autotel-posthog",
  "version": "13.0.5",
  "description": "Everything PostHog for autotel: browser session/replay join, server-side event subscriber, and trace links in both directions",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./subscriber": {
      "types": "./dist/subscriber.d.ts",
      "import": "./dist/subscriber.js",
      "require": "./dist/subscriber.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "slow-redact": "^0.3.2"
  },
  "peerDependencies": {
    "@opentelemetry/sdk-trace-base": ">=2.0.0",
    "autotel": "workspace:*",
    "autotel-subscribers": "workspace:*",
    "autotel-web": "workspace:*",
    "posthog-js": ">=1.200.0",
    "posthog-node": ">=4.0.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@types/node": "^26.6.3",
    "autotel": "workspace:*",
    "autotel-subscribers": "workspace:*",
    "autotel-web": "workspace:*",
    "jsdom": "30.1.1",
    "posthog-js": "1.434.17",
    "posthog-node": "^5.54.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "posthog",
    "session-replay",
    "product-analytics",
    "tracing",
    "observability",
    "autotel"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-posthog"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "posthog-js": {
      "optional": true
    },
    "autotel": {
      "optional": true
    },
    "autotel-subscribers": {
      "optional": true
    },
    "posthog-node": {
      "optional": true
    }
  }
}
