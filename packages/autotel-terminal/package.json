{
  "name": "autotel-terminal",
  "version": "47.0.0",
  "description": "Terminal dashboard for autotel traces using react-ink",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "bin": {
    "autotel-terminal": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format:check": "prettier --check src/**/*.ts",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "lint:fix": "pnpm lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-exports": "attw --pack . --ignore-rules false-esm no-resolution cjs-resolves-to-esm",
    "quality": "pnpm type-check && pnpm test && pnpm lint && pnpm format:check && pnpm build && pnpm check-exports"
  },
  "keywords": [
    "autotel",
    "opentelemetry",
    "terminal",
    "dashboard",
    "traces",
    "spans",
    "ink",
    "react",
    "cli",
    "observability"
  ],
  "author": "Jag Reehal<jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@json-render/core": "^0.21.0",
    "@json-render/ink": "^0.21.0",
    "ai": "^7.0.118",
    "ai-sdk-ollama": "^4.3.0",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "autotel": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "autotel": "workspace:*",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-terminal"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel#readme"
}
