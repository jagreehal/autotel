{
  "name": "autotel-nuxt",
  "version": "17.0.0",
  "description": "Nuxt module for Autotel observability via Nitro adapters",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "require": "./dist/module.cjs"
    },
    "./runtime/nitro": {
      "types": "./dist/runtime/nitro.d.ts",
      "import": "./dist/runtime/nitro.js",
      "require": "./dist/runtime/nitro.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "oxlint -c oxlint.json --disable-nested-config src"
  },
  "dependencies": {
    "autotel-adapters": "workspace:*"
  },
  "peerDependencies": {
    "autotel": "workspace:*",
    "nuxt": "^4.5.2",
    "nitropack": "^2.13.4"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.2",
    "@types/node": "^26.6.3",
    "autotel": "workspace:*",
    "nuxt": "^4.5.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-nuxt"
  }
}
