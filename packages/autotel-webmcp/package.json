{
  "name": "autotel-webmcp",
  "version": "0.3.0",
  "description": "OpenTelemetry instrumentation for WebMCP - traces in-page agent tool calls from the browser",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "autotel-web": "^1.13.3"
  },
  "keywords": [
    "webmcp",
    "opentelemetry",
    "autotel",
    "mcp",
    "agents",
    "tracing"
  ],
  "license": "Apache-2.0",
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-webmcp"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel/tree/main/packages/autotel-webmcp#readme",
  "devDependencies": {
    "autotel-web": "workspace:*",
    "happy-dom": "20.11.6",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "webmcp-types": "0.1.5"
  }
}
