{
  "name": "autotel-kafka",
  "version": "0.1.0",
  "description": "Kafka observability for autotel: processing and producer spans, batch lineage, consumer lag and group events for KafkaJS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint -c oxlint.json --disable-nested-config src",
    "lint:fix": "pnpm lint --fix",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "check-format": "prettier --check ./src",
    "check-exports": "attw --pack . --ignore-rules false-esm no-resolution cjs-resolves-to-esm",
    "clean": "rimraf dist",
    "quality": "pnpm type-check && pnpm test && pnpm lint && pnpm format:check && pnpm build && pnpm check-exports"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "kafka",
    "kafkajs",
    "messaging",
    "event-driven",
    "observability",
    "tracing",
    "telemetry"
  ],
  "author": "Jag Reehal <jag@jagreehal.com> (https://jagreehal.com)",
  "license": "Apache-2.0",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "autotel": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/instrumentation-kafkajs": ">=0.32.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/instrumentation-kafkajs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@opentelemetry/core": "^2.12.0",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/autotel",
    "directory": "packages/autotel-kafka"
  },
  "bugs": {
    "url": "https://github.com/jagreehal/autotel/issues"
  },
  "homepage": "https://github.com/jagreehal/autotel/tree/main/packages/autotel-kafka#readme"
}
